{
  "name": "machinebridge",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "tsx apps/server/src/main.ts",
    "dev:stdio": "tsx apps/server/src/main.ts --stdio",
    "dev:cli": "tsx apps/cli/src/main.ts",
    "start": "node apps/server/dist/main.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit",
    "test:oauth": "node scripts/test-oauth-local.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:server": "pnpm build && node scripts/package-server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@machinebridge/config": "workspace:^",
    "@machinebridge/crypto": "workspace:^",
    "@machinebridge/fs": "workspace:^",
    "@machinebridge/protocol": "workspace:^",
    "@machinebridge/pty": "workspace:^",
    "@machinebridge/shared": "workspace:^",
    "@machinebridge/tunnel": "workspace:^",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@yao-pkg/pkg": "^6.5.0",
    "eslint": "^9.17.0",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  }
}
