# Node Environment
NODE_ENV=development

# Server Network Configuration
EDGE_HOST=0.0.0.0
EDGE_PORT=8080

# Authentication & Security
# Header required: "X-API-Key: <key>" or "Authorization: Bearer <key>"
MACHINEBRIDGE_API_KEY=machinebridge-dev-key

# Terminal & Session Limits
MACHINEBRIDGE_MAX_SESSIONS=8
MACHINEBRIDGE_SESSION_TTL_SECONDS=3600
MACHINEBRIDGE_MAX_BUFFER_BYTES=4194304
MACHINEBRIDGE_MAX_MESSAGE_BYTES=1048576

# Cloudflare Tunnel (Public Port Exposure)
# Set to 'true' or '1' to automatically expose the port via Cloudflare Tunnel (https://*.trycloudflare.com)
MACHINEBRIDGE_EXPOSE_TUNNEL=false

# Optional: Cloudflare Tunnel Token for named tunnels on custom domains
# MACHINEBRIDGE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
